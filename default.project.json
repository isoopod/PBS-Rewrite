{
	"name": "rewrite",
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$path": "src/ServerScriptService"
		},
		"ServerStorage": {
			"$path": "src/ServerStorage"
		},
		"ReplicatedStorage": {
			"Packages": {
				"$path": "roblox_packages"
			},
			"$path": "src/ReplicatedStorage"
		}
	},
	"syncback": {
		"ignoreGlobs": ["**/.pesde/**", "roblox_packages/**"],
		"ignoreNames": ["Packages", "wally"]
	}
}
